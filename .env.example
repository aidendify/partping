PORT=8080
DATABASE_PATH=/data/partping.db
SECRET_KEY=change-me

# Set this on any VPS reachable from the internet. Empty = open admin (local/dev only).
OWNER_PASSWORD=

BUSINESS_NAME=
BUSINESS_PHONE=
PUBLIC_BASE_URL=http://localhost:8080

FROM_NAME=
FROM_EMAIL=

# Optional SMTP. Leave SMTP_HOST unset to copy link / blurbs without sending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true

# Optional Twilio SMS. Leave unset to hide SMS UI; product works via Copy link alone.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Optional copy of milestone changes to the owner when SMTP is set.
OWNER_NOTIFY_EMAIL=

# Optional footer link labeled "Powered by PartPing". Leave empty for no footer.
MARKETING_URL=
